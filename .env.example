# Code-Graph-RAG Environment Variables Template
# Copy this file to .env and configure if external models or remote backends are needed.

# Graph Storage Backend (default: embedded SQLite)
# CGR uses embedded SQLite (~/.cgr/graph.sqlite) automatically out-of-the-box.
# If connecting to external Memgraph or Neo4j:
# MEMGRAPH_HOST=localhost
# MEMGRAPH_PORT=7687

# Model Providers for 'cgr start --ask-agent' / Cypher generation (optional):
# Supported providers: ollama, openai, anthropic, google
# ORCHESTRATOR_PROVIDER=ollama
# ORCHESTRATOR_MODEL=llama3.2
# CYPHER_PROVIDER=ollama
# CYPHER_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# API Keys (if using cloud providers):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Embeddings & Sync Controls:
# CGR_SKIP_EMBEDDINGS=0
